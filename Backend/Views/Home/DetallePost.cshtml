@model BackEnd.Models.DetallePostViewModel

<div class="container mx-auto mt-8 px-4">
    <div class="bg-white rounded-lg shadow-lg p-6 md:p-8">
        <h1 class="text-4xl font-bold mb-6 text-gray-800 text-center">Detalle del Post</h1>
        
        <div class="mb-6">
            <img src="~/images/@Model.Post.UrlImagen" alt="Imagen del post" class="w-full h-auto rounded-lg shadow-md">
        </div>
        
        <div class="mb-6">
            <p class="text-lg text-gray-700 leading-relaxed">@Model.Post.Contenido</p>
        </div>
        
        <div class="mb-6">
            <p class="text-sm text-gray-500">Publicado por: <span class="font-semibold text-gray-800">@Model.Usuario.NombreUsuario</span></p>
            <p class="text-sm text-gray-500">Fecha: <span class="font-semibold text-gray-800">@Model.Post.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</span></p>
        </div>
        
        <div class="flex items-center mb-6">
            <form asp-controller="Home" asp-action="Perfil" asp-route-id="@Model.Post.IdUsuario" method="get">
                <input type="image" title="@Model.Usuario.NombreUsuario"
                       src="@("/images/" + (@Model.Usuario.FotoPerfil ?? "Imagenens-layout/svg/Usuario-Icono.svg"))"
                       class="rounded-full w-16 h-16 object-cover cursor-pointer border-2 border-gray-300 hover:border-blue-500 transition duration-300" />
            </form>
            <div class="ml-4">
                <p class="text-lg font-semibold text-gray-800">@Model.Usuario.NombreUsuario</p>
                @* <p class="text-sm text-gray-500">Última actividad: @Model.Usuario.UltimaActividad.ToString("dd/MM/yyyy HH:mm")</p> *@
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div class="flex justify-center items-center">
                <button class="bg-blue-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-blue-600 transition duration-300 w-full">
                    Me gusta
                </button>
            </div>
            <div class="flex justify-center items-center">
                <button class="bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg hover:bg-gray-400 transition duration-300 w-full">
                    Compartir
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container mx-auto mt-8 px-4">
    <div class="bg-gray-100 rounded-lg shadow-lg p-6 md:p-8">
        <h2 class="text-2xl font-bold mb-4 text-gray-800">Comentarios</h2>
        <div class="space-y-4"
        >
            @* Aquí puedes agregar un bucle para mostrar los comentarios
            @foreach (var comentario in Model.Comentarios)
            {
                <div class="bg-white rounded-lg p-4 shadow-md">
                    <p class="text-sm text-gray-500">Publicado por: <span class="font-semibold text-gray-800">@comentario.Usuario.NombreUsuario</span></p>
                    <p class="text-gray-700">@comentario.Contenido</p>
                    <p class="text-xs text-gray-500">Fecha: <span class="font-semibold text-gray-800">@comentario.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</span></p>
                </div>
            } *@
        </div>
    </div>
</div>