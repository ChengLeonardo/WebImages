                    <svg id="mooon" class="duration-300 opacity-0 fill-gris hover:fill-azul relative ml-4 h-7 w-8" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 34.56 34.34">
                        <path class="cls-1" d="M23.59,1.34c.2-1.22,1.5-1.64,2.62-1.13,3.67,1.68,8.35,9.09,8.35,15.49,0,10.29-8.34,18.63-18.63,18.63-6.65,0-14.38-4.94-15.76-8.78-.42-1.16-.03-2.43,1.19-2.59l5.34-.73c8.18-1.12,14.68-7.44,16.02-15.59l.87-5.3Z"/>
                    </svg>
                </div>
            </nav>
        </header>
        <section class="transition-all duration-300 dark:bg-neutral-900 bg-gris flex justify-center items-center">
            <div class="transition-all duration-300 dark:bg-neutral-800 flex flex-col items-center bg-white h-4/5 w-4/5 rounded-3xl">
                <!--Foto de perfil-->
                <svg class="transition-all duration-300 dark:bg-neutral-700 dark:fill-neutral-600 dark:border-none border-gris p-4 mt-8 rounded-full fill-gris h-40 w-40 bg-grisOscuro" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 125.71 170.52">
                    <circle class="cls-1" cx="62.86" cy="40.81" r="37.31"/>
                    <path class="cls-1" d="M62.86,166.97s49.73,2.37,59.26-26.52c2.93-63.17-59.26-62.32-59.26-62.32,0,0-62.18-.84-59.26,62.32,9.52,28.89,59.26,26.52,59.26,26.52Z"/>
                </svg>
                <form class="w-full mt-4 rounded-3xl h-12 justify-center flex items-center" asp-controller="Home" enctype="multipart/form-data" asp-action="EditarFoto" method="post">
                    <label for="NuevaFotoPerfil" class="mr-4 bg-azul h-8 w-24 font-bold flex justify-center items-center rounded-2xl cursor-pointer hover:bg-azulOscuro duration-300">Editar foto</label>
                    <input id="NuevaFotoPerfil" class="hidden" type="file" name="NuevaFotoPerfil">
                    <button class="bg-azul h-8 px-4 w-auto font-bold flex justify-center items-center rounded-2xl cursor-pointer hover:bg-azulOscuro duration-300" type="submit" >Guardar Cambios</button>
                </form>
                <form class="w-full mt-6 justify-center flex items-center flex-col" method="post" asp-controller="Home" asp-action="Editar">
                    <input type="hidden" value="Descripcion" asp-for="Que"/>
                    <label class="text-azul font-bold font-medium" for="">Descripcion:</label>
                    <input class="duration-300 dark:bg-neutral-700 border-2 dark:border-none border-gris outline-none focus:border-gris rounded-2xl mt-4 bg-gris text-white h-24 w-4/5" type="text" asp-for="Descripcion">
                    <button type="submit" class="mt-2 bg-azul h-8 px-4 w-auto font-bold flex justify-center items-center rounded-2xl cursor-pointer hover:bg-azulOscuro duration-300">Guardar</button>
                </form>
            </div>
        </section>
        <!--Editar InfoPersonal-->
        <section class="transition-all duration-300 dark:bg-neutral-900 bg-gris flex justify-center items-center">
            <div class="transition-all duration-300 dark:bg-neutral-800 bg-white h-4/5 w-4/5 rounded-3xl flex flex-col justify-center items-center">
                <form method="post" class="duration-300 dark:bg-neutral-700 flex p-4 items-center h-12 w-4/5 bg-gris rounded-2xl" asp-controller="Home" asp-action="Editar">
                    <input type="hidden" value="Nombre" asp-for="Que"/>
                    <p class="font-medium text-2xl font-bold text-azul">Nombre:</p>
                    <!--Aqui iria c# para el nombre-->
                    <input class="duration-300 dark:bg-neutral-700 ml-6 w-48 bg-gris outline-none text-2xl font-bold" type="text" asp-for="Nombre">
                    <button type="submit" class="bg-white rounded-2xl hover:bg-azul duration-300">
                        <svg class="dark:hover:fill-neutral-500 duration-300 hover:fill-gris fill-azul stroke-2 stroke-white h-8 w-8" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32.51 32.5">
                            <path class="cls-1" d="M3.08,21.92L24.2.8c.4-.4,1.04-.4,1.44,0l6.07,6.07c.4.4.4,1.04,0,1.44L9.92,30.11l-6.98,1.83c-1.49.39-2.81-1.02-2.33-2.48l2.48-7.54Z"/>
                            <path class="cls-1" d="M3.03,22.06h2.41c.87,0,1.59.67,1.65,1.53l.05.71c.05.69.53,1.28,1.2,1.47l.5.14c.71.2,1.21.86,1.2,1.6v2.83"/>
                        </svg>
                    </button>
                </form>
                <form method="post" class="duration-300 dark:bg-neutral-700 my-8 flex p-4 items-center h-12 w-4/5 bg-gris rounded-2xl" asp-controller="Home" asp-action="Editar">
                                    <input type="hidden" value="Apellido" asp-for="Que"/>
                    <p class="font-medium text-2xl font-bold text-azul">Apellido:</p>
                    <!--Aqui iria c# para el Apellido-->
                    <input class="duration-300 dark:bg-neutral-700 ml-6 w-48 bg-gris outline-none text-2xl font-bold" type="text" asp-for="Apellido">
                    <button type="submit" class="bg-white rounded-2xl hover:bg-azul duration-300">
                        <svg class="dark:hover:fill-neutral-500 duration-300 hover:fill-gris fill-azul stroke-2 stroke-white h-8 w-8" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32.51 32.5">
                            <path class="cls-1" d="M3.08,21.92L24.2.8c.4-.4,1.04-.4,1.44,0l6.07,6.07c.4.4.4,1.04,0,1.44L9.92,30.11l-6.98,1.83c-1.49.39-2.81-1.02-2.33-2.48l2.48-7.54Z"/>
                            <path class="cls-1" d="M3.03,22.06h2.41c.87,0,1.59.67,1.65,1.53l.05.71c.05.69.53,1.28,1.2,1.47l.5.14c.71.2,1.21.86,1.2,1.6v2.83"/>
                        </svg>
                    </button>
                </form>
                <form method="post" class="duration-300 dark:bg-neutral-700 flex p-4 items-center h-12 w-4/5 bg-gris rounded-2xl" asp-controller="Home" asp-action="Editar">
                    <input type="hidden" value="Correo" asp-for="Que"/>
                    <p class="font-medium text-2xl font-bold text-azul">Correo:</p>
                    <!--Aqui iria c# para el Correo-->
                    <input class="duration-300 dark:bg-neutral-700 ml-6 w-48 bg-gris outline-none text-2xl font-bold" type="text" asp-for="Email">
                    <button type="submit" class="bg-white rounded-2xl hover:bg-azul duration-300">
                        <svg class="dark:hover:fill-neutral-500 duration-300 hover:fill-gris fill-azul stroke-2 stroke-white h-8 w-8" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32.51 32.5">
                            <path class="cls-1" d="M3.08,21.92L24.2.8c.4-.4,1.04-.4,1.44,0l6.07,6.07c.4.4.4,1.04,0,1.44L9.92,30.11l-6.98,1.83c-1.49.39-2.81-1.02-2.33-2.48l2.48-7.54Z"/>
                            <path class="cls-1" d="M3.03,22.06h2.41c.87,0,1.59.67,1.65,1.53l.05.71c.05.69.53,1.28,1.2,1.47l.5.14c.71.2,1.21.86,1.2,1.6v2.83"/>
                        </svg>
                    </button>
                </form>
            </div>
        </section>
    </main>
</body>