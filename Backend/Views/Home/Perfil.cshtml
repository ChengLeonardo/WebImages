@model BackEnd.Models.PerfilViewModel;
@{
    var fotoPath = "/images/" + (Model.Usuario.FotoPerfil ?? "default.jpg");
}
<body class="transition-all duration-300 dark:bg-neutral-900 h-screen w-full grid grid-cols-[35%_1fr]">
    <main class="grid grid-rows-[10vh_90vh]">
        <!--Perfil de usuario-->
        <header class="justify-center items-center flex">
            <nav class="transition-all duration-300 dark:bg-neutral-800 mt-8 flex justify-center items-center rounded-2xl h-4/5 w-72 bg-grisOscuro">
                <a asp-controller="Home" asp-action="CrearPost"> <!-- Cambiar a la acción correspondiente -->
                    <svg class="group h-8 w-8" id="Galeria" data-name="Galeria" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 49.39 49.39">
                        <rect class="duration-300 fill-gris group-hover:fill-Cielo" width="49.39" height="49.39" rx="5.76" ry="5.76"/>
                        <path class="duration-300 fill-grisOscuro group-hover:fill-VerdeOscuro" d="M0,29.48v-10.61l7.99-7.99c1.12-1.12,2.94-1.12,4.06,0l8.42,8.42,2.96-2.96c1.12-1.12,2.94-1.12,4.06,0l13.56,13.56-41.05-.42Z"/>
                        <path class="duration-300 fill-grisMasOscuro group-hover:fill-Verde" d="M0,29.48l49.39.24v13.74c0,3.27-2.65,5.93-5.93,5.93H5.93c-3.27,0-5.93-2.65-5.93-5.93v-13.98Z"/>
                        <circle class="duration-300 fill-grisOscuro group-hover:fill-Amarillo" cx="43.17" cy="6.04" r="3.63"/>
                    </svg>
                </a>
                <a asp-controller="Home" asp-action="Perfil">
                    <svg class="duration-300 hover:fill-Verde h-8 w-8 fill-white ml-4" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 125.71 170.52">
                        <circle class="cls-1" cx="62.86" cy="40.81" r="37.31"/>
                        <path class="cls-1" d="M62.86,166.97s49.73,2.37,59.26-26.52c2.93-63.17-59.26-62.32-59.26-62.32,0,0-62.18-.84-59.26,62.32,9.52,28.89,59.26,26.52,59.26,26.52Z"/>
                    </svg>
                </a>
                <a asp-controller="Home" asp-action="Index">
                    <svg class="duration-300 hover:fill-azul ml-4 fill-white h-8 w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                        <path d="m21.743 12.331-9-10c-.379-.422-1.107-.422-1.486 0l-9 10a.998.998 0 0 0-.17 1.076c.16.361.518.593.913.593h2v7a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-4h4v4a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-7h2a.998.998 0 0 0 .743-1.669z"></path>
                    </svg>
                </a>
                <a asp-controller="Home" asp-action="Configuracion">
                    <svg class="duration-500 hover:rotate-180 ml-4 h-8 w-8 fill-white hover:fill-sky-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m2.344 15.271 2 3.46a1 1 0 0 0 1.366.365l1.396-.806c.58.457 1.221.832 1.895 1.112V21a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-1.598a8.094 8.094 0 0 0 1.895-1.112l1.396.806c.477.275 1.091.11 1.366-.365l2-3.46a1.004 1.004 0 0 0-.365-1.366l-1.372-.793a7.683 7.683 0 0 0-.002-2.224l1.372-.793c.476-.275.641-.89.365-1.366l-2-3.46a1 1 0 0 0-1.366-.365l-1.396.806A8.034 8.034 0 0 0 15 4.598V3a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v1.598A8.094 8.094 0 0 0 7.105 5.71L5.71 4.904a.999.999 0 0 0-1.366.365l-2 3.46a1.004 1.004 0 0 0 .365 1.366l1.372.793a7.683 7.683 0 0 0 0 2.224l-1.372.793c-.476.275-.641.89-.365 1.366zM12 8c2.206 0 4 1.794 4 4s-1.794 4-4 4-4-1.794-4-4 1.794-4 4-4z"></path></svg>
                </a>
                <div class="relative">
                    <svg class="duration-300 absolute fill-white cursor-pointer z-10 hover:fill-Amarillo h-8 w-8 ml-4" id="sun" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 42.23 42.65">
                      <circle class="cls-2" cx="21.09" cy="21.4" r="10.45"/>
                      <path class="cls-1 fill-none" d="M34.55,21.27c.06,5.56-3.49,9.08-4.14,9.71-3.81,3.65-8.41,3.74-9.31,3.74-.88,0-5.66-.09-9.52-3.94-.47-.47-3.98-4.09-3.94-9.51,0-.49.05-3.03,1.44-5.89,1.11-2.29,2.53-3.66,2.91-4.01.58-.54,1.92-1.69,3.97-2.54,2.41-.99,4.47-1.02,5.14-1.01,3.07.04,5.26,1.19,6.16,1.68,1.91,1.03,3.11,2.25,3.54,2.71.76.81,3.7,4.05,3.75,9.06Z"/>
                      <path class="cls-2" d="M26.63,34.57l-4.63,7.5c-.48.78-1.62.77-2.09-.03l-4.35-7.48h11.06Z"/>
                      <path class="cls-2" d="M15.56,8.08L20.19.58c.48-.78,1.62-.77,2.09.03l4.35,7.48h-11.06Z"/>
                      <path class="cls-2" d="M8.08,26.81L.58,22.18c-.78-.48-.77-1.62.03-2.09l7.48-4.35v11.06Z"/>
                      <path class="cls-2" d="M34.15,15.42l7.5,4.63c.78.48.77,1.62-.03,2.09l-7.48,4.35v-11.06Z"/>
                      <path class="cls-2" d="M7.77,15.74l-2.03-8.58c-.21-.89.61-1.69,1.49-1.46l8.36,2.21-7.82,7.82Z"/>
                      <path class="cls-2" d="M15.68,34.32l-8.58,2.03c-.89.21-1.69-.61-1.46-1.49l2.21-8.36,7.82,7.82Z"/>
                      <path class="cls-2" d="M34.42,26.81l2.03,8.58c.21.89-.61,1.69-1.49,1.46l-8.36-2.21,7.82-7.82Z"/>
                      <path class="cls-2" d="M26.41,7.83l8.58-2.03c.89-.21,1.69.61,1.46,1.49l-2.21,8.36-7.82-7.82Z"/>
                    </svg>
                    <svg id="mooon" class="duration-300 opacity-0 fill-white hover:fill-azul relative ml-4 h-7 w-8" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 34.56 34.34">
                        <path class="cls-1" d="M23.59,1.34c.2-1.22,1.5-1.64,2.62-1.13,3.67,1.68,8.35,9.09,8.35,15.49,0,10.29-8.34,18.63-18.63,18.63-6.65,0-14.38-4.94-15.76-8.78-.42-1.16-.03-2.43,1.19-2.59l5.34-.73c8.18-1.12,14.68-7.44,16.02-15.59l.87-5.3Z"/>
                    </svg>
                </div>
            </nav>
        </header>
        <section class="flex justify-center items-center">
            <div class="transition-all duration-300 dark:bg-neutral-800 py-2 text-white h-11/12 w-11/12 flex flex-col justify-start items-center bg-gris rounded-3xl">
                @if(string.IsNullOrEmpty(Model.Usuario.FotoPerfil))
                {
                <div class="transition-all duration-300 dark:bg-neutral-700 h-72 w-72 rounded-full m-2 bg-white flex justify-center items items-center">
                    <svg class="transition-all duration-300 dark:fill-neutral-600 rounded-full fill-gris h-3/5 w-3/5" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 125.71 170.52">
                        <circle class="cls-1" cx="62.86" cy="40.81" r="37.31"/>
                        <path class="cls-1" d="M62.86,166.97s49.73,2.37,59.26-26.52c2.93-63.17-59.26-62.32-59.26-62.32,0,0-62.18-.84-59.26,62.32,9.52,28.89,59.26,26.52,59.26,26.52Z"/>
                    </svg>
                </div>
                }
                else{
                <div class="transition-all duration-300 dark:bg-neutral-700 h-72 w-72 rounded-full m-2 bg-white flex justify-center items-center">
                    <img class="h-full w-full rounded-full flex justify-center items-center" src="@fotoPath" asp-append-version/>
                </div>
                }
                <h2 class="mb-2 text-2xl font-medium">@Model.Usuario.NombreUsuario</h2>
                <div class="mb-2 flex text-xl">
                    <p class="mr-4">@Model.Usuario.Nombre</p>
                    <p>@Model.Usuario.Apellido</p>
                </div>
                <p class="transition-all duration-300 text-center dark:bg-neutral-700 placeholder-white mb-2 border-2 outline-none bg-gris border-none text-white w-72 rounded-lg h-8 pl-4">@Model.Usuario.Email</p>
                @if(Model.EsUsuarioActual)
                {
                    <a asp-action="Configuracion" asp-controller="Home" class="hover:bg-azulOscuro hover:scale-110 duration-300 flex mt-2 justify-center rounded-3xl h-10 w-48 bg-azul font-medium text-lg py-2">Configuración</a>
                }
            </div>    
        </section>
    </main>
    <!--Contenedor grid-->
    <section class="max-h-screen items-center flex justify-center">
        <div class="pt-4 transition-all duration-300 dark:bg-neutral-800 overflow-y-auto flex items-center px-8 flex-row justify-center flex-wrap h-11/12 w-11/12 bg-gris rounded-xl">
            @foreach (var post in Model.PostsUsuario)
            {
                <a href="@Url.Action("Index", "Home", new { Direction = post.IdPost })" class="block mx-4 mb-4 h-40 w-40 bg-white rounded-xl">
                    <div class="h-full w-full relative">
                        <img src="@("/images/" + @post.UrlImagen)" alt="Post Image" class="h-full w-full object-cover rounded-xl">
                        <div class="absolute bottom-0 left-0 right-0 bg-black bg-opacity-50 text-white p-1 rounded-b-xl">
                            <p style="font-size: 10px;" class="text-center ">@post.FechaPublicacion.ToShortDateString()</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>

</body>
</html>
